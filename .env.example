# =============================================================================
# RAG DevAI Chatbot - environment configuration
# Copy this file to `.env` and fill in the values you need.
# Every value is optional when running fully offline.
# =============================================================================

# ----------------------------------------------------------------------------
# LLM provider selection
#   auto   : use the first configured API key (openai > gemini > groq); if none,
#            fall back to the offline extractive generator.
#   openai : OpenAI-compatible chat completions (also works for Azure/proxies).
#   gemini : Google Gemini via the OpenAI-compatible endpoint.
#   groq   : Groq via the OpenAI-compatible endpoint.
#   local  : offline extractive answer generator (no network, no hallucination).
# ----------------------------------------------------------------------------
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# Generation behaviour
# ----------------------------------------------------------------------------
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# ----------------------------------------------------------------------------
# Embeddings (local by default; cached on disk after the first run)
# ----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ----------------------------------------------------------------------------
# Chunking
# ----------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP=0.15

# ----------------------------------------------------------------------------
# Retrieval
# ----------------------------------------------------------------------------
DENSE_TOP_K=48
BM25_TOP_K=48
RERANK_TOP_K=5
FINAL_TOP_K=6
HYBRID_ALPHA=0.5
HYBRID_METHOD=weighted          # weighted | rrf
MIN_SIMILARITY=0.35
# Out-of-knowledge floor: below this best-dense-cosine, the sparse-token
# fallback in the sufficiency gate never marks evidence sufficient.
KNOWLEDGE_BOUNDARY_MIN_SIM=0.30
USE_QUERY_EXPANSION=true
USE_QUERY_ROUTING=true
CONTEXT_MAX_TOKENS=4000

# ----------------------------------------------------------------------------
# Reranker (optional; disabled by default after Phase 3 ablation showed no
# measured lift — see docs/eval_results/ablation/<run>/REPORT.md)
# ----------------------------------------------------------------------------
USE_RERANKER=false
RERANKER_KIND=cross                 # cross | score (experimental rerankers)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------------------------
# Caching
# ----------------------------------------------------------------------------
ENABLE_RETRIEVAL_CACHE=true
CACHE_DIR=data/processed/cache

# ----------------------------------------------------------------------------
# Evaluation
# ----------------------------------------------------------------------------
EVAL_QUESTIONS_PATH=src/evaluation/questions.json
EVAL_REPORT_PATH=docs/evaluation_report.md
ABSTAIN_QUESTIONS_PATH=src/evaluation/abstain_questions.json
ADVERSARIAL_CASES_PATH=src/evaluation/adversarial_cases.json

# ----------------------------------------------------------------------------
# API security (FastAPI)
# ----------------------------------------------------------------------------
API_MAX_QUESTION_CHARS=4000
API_RATE_LIMIT_PER_MIN=60             # 0 disables the in-process token bucket
# API_AUTH_USERNAME=                  # set both to require HTTP Basic auth
# API_AUTH_PASSWORD=